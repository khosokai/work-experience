---
import Base from '../../layouts/Base.astro';
import DetailDialog from '../../components/DetailDialog.astro';
import DesignSwitcher from '../../components/DesignSwitcher.astro';
import { getExperiences, getProfile, formatYm } from '../../lib/experience';
import '../../styles/dialog.css';

const profile = await getProfile();
const items = await getExperiences();
const fonts =
  'https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap';
---

<Base title={`${profile.name} | 職務経歴`} description={profile.headline} fonts={fonts} design="a">
  <header class="hero">
    <div class="wrap">
      <p class="hero-name">{profile.name}<span>{profile.nameEn}</span></p>
      <h1>{profile.headline}</h1>
      <p class="hero-meta">{profile.title}／{profile.location}</p>
      <div class="hero-intro"><profile.Content /></div>
      <ul class="hero-links">
        {profile.links.map((l) => <li><a href={l.url} rel="me noopener">{l.label}</a></li>)}
      </ul>
    </div>
  </header>

  <main class="wrap">
    <h2 class="section-title">職務経歴</h2>
    <ol class="timeline">
      {
        items.map((item) => (
          <li class:list={['entry', { current: item.current, education: item.type === 'education' }]}>
            <p class="entry-period">
              <span>{item.startLabel}</span>
              <span>{item.endLabel}</span>
            </p>
            <div class="entry-body">
              <h3>
                {item.company}
                <span class="entry-duration">{item.duration}</span>
              </h3>
              <p class="entry-role">
                {item.role}
                {item.current && <span class="badge">現在</span>}
              </p>
              {item.summary && <p class="entry-summary">{item.summary}</p>}
              {item.highlights.length > 0 && (
                <ul class="entry-highlights">
                  {item.highlights.map((h) => <li>{h}</li>)}
                </ul>
              )}
              {item.hasDetail && (
                <button type="button" class="more" data-open={item.slug}>
                  詳しく見る
                </button>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <div class="extras">
      <section>
        <h2 class="section-title">スキル</h2>
        <ul class="skills">
          {profile.skills.map((s) => <li>{s}</li>)}
        </ul>
      </section>
      <section>
        <h2 class="section-title">資格</h2>
        <ul class="certs">
          {
            profile.certifications.map((c) => (
              <li>
                {c.name}
                <span>{formatYm(c.date)}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </main>

  {items.filter((i) => i.hasDetail).map((item) => <DetailDialog item={item} />)}
  <DesignSwitcher current="a" />
</Base>

<style is:global>
  body[data-design='a'] {
    --bg: #ffffff;
    --surface: #f2f6f6;
    --text: #17262b;
    --muted: #5d6f75;
    --line: #d9e2e3;
    --accent: #0f5e63;
    --accent-contrast: #ffffff;
    --dialog-bg: #ffffff;
    --chip-bg: #e6eeee;
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'Zen Kaku Gothic New', 'Hiragino Sans', 'Yu Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
  }

  @media (prefers-color-scheme: dark) {
    body[data-design='a'] {
      --bg: #101a1c;
      --surface: #17262a;
      --text: #e6eeee;
      --muted: #94a7ab;
      --line: #2a3d41;
      --accent: #6fc7c2;
      --accent-contrast: #0b1719;
      --dialog-bg: #17262a;
      --chip-bg: #23383c;
    }
  }

  [data-design='a'] .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }

  [data-design='a'] .hero {
    padding: 72px 0 56px;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  [data-design='a'] .hero-name {
    margin: 0 0 20px;
    font-size: 1rem;
    font-weight: 700;
  }

  [data-design='a'] .hero-name span {
    margin-left: 12px;
    font-weight: 400;
    color: var(--muted);
  }

  [data-design='a'] .hero h1 {
    margin: 0 0 16px;
    font-size: clamp(1.625rem, 4.6vw, 2.25rem);
    font-weight: 900;
    line-height: 1.35;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  [data-design='a'] .hero-meta,
  [data-design='a'] .hero-intro p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  [data-design='a'] .hero-links {
    display: flex;
    gap: 16px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  [data-design='a'] a {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  [data-design='a'] .section-title {
    margin: 56px 0 28px;
    font-size: 1.125rem;
    font-weight: 700;
  }

  [data-design='a'] .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [data-design='a'] .entry {
    display: grid;
    grid-template-columns: 6.5em 1fr;
    column-gap: 52px;
    position: relative;
    padding-bottom: 44px;
  }

  /* 縦線とノード */
  [data-design='a'] .entry::before {
    content: '';
    position: absolute;
    left: calc(6.5em + 25px);
    top: 14px;
    bottom: -14px;
    width: 2px;
    background: var(--line);
  }

  [data-design='a'] .entry:last-child::before {
    display: none;
  }

  [data-design='a'] .entry::after {
    content: '';
    position: absolute;
    left: calc(6.5em + 19px);
    top: 9px;
    width: 10px;
    height: 10px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
  }

  [data-design='a'] .entry.current::after {
    background: var(--accent);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  [data-design='a'] .entry.education::after {
    border-radius: 2px;
    border-color: var(--muted);
  }

  [data-design='a'] .entry-period {
    margin: 2px 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  [data-design='a'] .entry-period span:first-child::after {
    content: ' 〜';
  }

  [data-design='a'] .entry h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.5;
  }

  [data-design='a'] .entry-duration {
    margin-left: 10px;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--muted);
  }

  [data-design='a'] .entry-role {
    margin: 2px 0 10px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  [data-design='a'] .badge {
    margin-left: 8px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  [data-design='a'] .entry-summary {
    margin: 0 0 8px;
    font-size: 0.9375rem;
  }

  [data-design='a'] .entry-highlights {
    margin: 0 0 8px;
    padding-left: 1.2em;
    font-size: 0.875rem;
    color: var(--muted);
  }

  [data-design='a'] .more {
    margin-top: 8px;
    padding: 7px 18px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: transparent;
    color: var(--accent);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    cursor: pointer;
  }

  [data-design='a'] .more:hover {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  [data-design='a'] :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  [data-design='a'] .extras {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-top: 16px;
    padding-bottom: 120px;
    border-top: 1px solid var(--line);
  }

  [data-design='a'] .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [data-design='a'] .skills li {
    padding: 2px 12px;
    border-radius: 4px;
    background: var(--chip-bg);
    font-size: 0.875rem;
  }

  [data-design='a'] .certs {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  [data-design='a'] .certs li {
    margin-bottom: 12px;
    line-height: 1.5;
  }

  [data-design='a'] .certs span {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    [data-design='a'] .hero {
      padding: 48px 0 40px;
    }
    [data-design='a'] .entry {
      grid-template-columns: 1fr;
      padding-left: 28px;
    }
    [data-design='a'] .entry::before {
      left: 4px;
    }
    [data-design='a'] .entry::after {
      left: -2px;
    }
    [data-design='a'] .entry-period {
      flex-direction: row;
      gap: 4px;
      margin-bottom: 4px;
    }
    [data-design='a'] .extras {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
