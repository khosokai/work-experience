---
import Base from '../../layouts/Base.astro';
import DetailDialog from '../../components/DetailDialog.astro';
import DesignSwitcher from '../../components/DesignSwitcher.astro';
import { getExperiences, getProfile } from '../../lib/experience';
import '../../styles/dialog.css';

const profile = await getProfile();
const items = await getExperiences();
const fonts =
  'https://fonts.googleapis.com/css2?family=M+PLUS+1+Code:wght@400;500;700&display=swap';
const ym = (v?: string) => v ?? '現在';
---

<Base title={`${profile.name} | 職務経歴`} description={profile.headline} fonts={fonts} design="c">
  <div class="term">
    <header class="hero">
      <p class="prompt"><span>$</span> whoami</p>
      <h1>{profile.name}<span class="hero-en">{profile.nameEn}</span></h1>
      <p class="hero-meta">{profile.title} @ {profile.location}</p>
      <p class="hero-headline">{profile.headline}</p>
      <div class="hero-intro"><profile.Content /></div>
      <ul class="hero-links">
        {profile.links.map((l) => <li><a href={l.url} rel="me noopener">{l.label}</a></li>)}
      </ul>
    </header>

    <main>
      <p class="prompt"><span>$</span> git log --graph career</p>
      <ol class="log">
        {
          items.map((item) => (
            <li class:list={['commit', { current: item.current, education: item.type === 'education' }]}>
              <p class="commit-ref">
                <span class="range">{item.start}..{ym(item.end)}</span>
                <span class="dur">({item.duration})</span>
                {item.current && <span class="head">HEAD</span>}
              </p>
              <h2>{item.company}</h2>
              <p class="commit-role">{item.role}</p>
              {item.summary && <p class="commit-summary">{item.summary}</p>}
              {item.highlights.length > 0 && (
                <ul class="commit-files">
                  {item.highlights.map((h) => <li>{h}</li>)}
                </ul>
              )}
              {item.tags.length > 0 && (
                <ul class="commit-tags">
                  {item.tags.map((t) => <li>{t}</li>)}
                </ul>
              )}
              {item.hasDetail && (
                <button type="button" class="more" data-open={item.slug}>
                  詳しく見る
                </button>
              )}
            </li>
          ))
        }
      </ol>

      <p class="prompt"><span>$</span> cat skills certifications</p>
      <div class="extras">
        <ul class="commit-tags">
          {profile.skills.map((s) => <li>{s}</li>)}
        </ul>
        <table>
          <tbody>
            {
              profile.certifications.map((c) => (
                <tr>
                  <td>{c.date}</td>
                  <td>{c.name}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </main>
  </div>

  {items.filter((i) => i.hasDetail).map((item) => <DetailDialog item={item} />)}
  <DesignSwitcher current="c" />
</Base>

<style is:global>
  body[data-design='c'] {
    --bg: #15202b;
    --text: #d6dee6;
    --muted: #8496a8;
    --line: #2c3c4c;
    --accent: #e8b65a;
    --branch: #5fb3d4;
    --dialog-bg: #1b2835;
    --dialog-radius: 8px;
    --dialog-border: 1px solid #3a4d60;
    --chip-bg: #263747;
    --chip-text: #a9d4e6;
    --backdrop: rgb(6 11 16 / 0.7);
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'M PLUS 1 Code', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 15px;
    line-height: 1.8;
  }

  @media (prefers-color-scheme: light) {
    body[data-design='c'] {
      --bg: #f3f5f7;
      --text: #1d2a36;
      --muted: #5b6b7a;
      --line: #cfd8e0;
      --accent: #9a5b00;
      --branch: #1b6f8f;
      --dialog-bg: #ffffff;
      --dialog-border: 1px solid #b9c5cf;
      --chip-bg: #e2e9ee;
      --chip-text: #17536b;
      --backdrop: rgb(20 30 40 / 0.5);
    }
  }

  [data-design='c'] .term {
    max-width: 820px;
    margin: 0 auto;
    padding: 48px 24px 140px;
  }

  [data-design='c'] .prompt {
    margin: 0 0 16px;
    color: var(--muted);
  }

  [data-design='c'] .prompt span {
    margin-right: 0.5em;
    color: var(--accent);
  }

  [data-design='c'] .hero {
    margin-bottom: 56px;
  }

  [data-design='c'] .hero h1 {
    margin: 0;
    font-size: clamp(1.75rem, 6vw, 2.5rem);
    font-weight: 700;
    line-height: 1.4;
  }

  [data-design='c'] .hero-en {
    margin-left: 0.8em;
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--muted);
  }

  [data-design='c'] .hero-meta {
    margin: 4px 0 20px;
    color: var(--branch);
  }

  [data-design='c'] .hero-headline {
    margin: 0;
    font-weight: 500;
  }

  [data-design='c'] .hero-intro p {
    margin: 0;
    color: var(--muted);
  }

  [data-design='c'] .hero-links {
    display: flex;
    gap: 16px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  [data-design='c'] a {
    color: var(--branch);
    text-underline-offset: 4px;
  }

  [data-design='c'] .log {
    margin: 0 0 56px;
    padding: 0;
    list-style: none;
  }

  /* git log --graph 風の幹とノード */
  [data-design='c'] .commit {
    position: relative;
    padding: 0 0 36px 36px;
  }

  [data-design='c'] .commit::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--branch);
    opacity: 0.55;
  }

  [data-design='c'] .commit:first-child::before {
    top: 12px;
  }

  [data-design='c'] .commit:last-child::before {
    bottom: auto;
    height: 12px;
  }

  [data-design='c'] .commit::after {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 10px;
    height: 10px;
    border: 2px solid var(--branch);
    border-radius: 50%;
    background: var(--bg);
  }

  [data-design='c'] .commit.current::after {
    border-color: var(--accent);
    background: var(--accent);
  }

  [data-design='c'] .commit.education::after {
    border-radius: 0;
  }

  [data-design='c'] .commit-ref {
    margin: 0;
    font-size: 0.875rem;
  }

  [data-design='c'] .range {
    color: var(--accent);
  }

  [data-design='c'] .dur {
    margin-left: 0.6em;
    color: var(--muted);
  }

  [data-design='c'] .head {
    margin-left: 0.6em;
    padding: 0 8px;
    border: 1px solid var(--accent);
    border-radius: 3px;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
  }

  [data-design='c'] .commit h2 {
    margin: 2px 0 0;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.5;
  }

  [data-design='c'] .commit-role {
    margin: 0 0 10px;
    color: var(--branch);
    font-size: 0.875rem;
  }

  [data-design='c'] .commit-summary {
    margin: 0 0 8px;
    max-width: 44em;
  }

  [data-design='c'] .commit-files {
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--muted);
  }

  [data-design='c'] .commit-files li::before {
    content: '+ ';
    color: var(--accent);
  }

  [data-design='c'] .commit-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }

  [data-design='c'] .commit-tags li {
    padding: 0 8px;
    border-radius: 4px;
    background: var(--chip-bg);
    color: var(--chip-text);
    font-size: 0.75rem;
    line-height: 1.9;
  }

  [data-design='c'] .more {
    padding: 4px 14px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background: transparent;
    color: var(--accent);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  [data-design='c'] .more::before {
    content: '> ';
  }

  [data-design='c'] .more:hover {
    background: var(--accent);
    color: var(--bg);
  }

  [data-design='c'] :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  [data-design='c'] .extras table {
    margin-top: 16px;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  [data-design='c'] .extras td {
    padding: 2px 0;
    vertical-align: top;
  }

  [data-design='c'] .extras td:first-child {
    padding-right: 1.5em;
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    body[data-design='c'] {
      font-size: 14px;
    }
    [data-design='c'] .term {
      padding: 32px 16px 120px;
    }
    [data-design='c'] .commit {
      padding-left: 26px;
    }
    [data-design='c'] .hero-en {
      display: block;
      margin-left: 0;
    }
  }
</style>
