---
import Base from '../layouts/Base.astro';
import DetailDialog from '../components/DetailDialog.astro';
import { getTimeline, getProfile } from '../lib/experience';
import '../styles/dialog.css';

const profile = await getProfile();
const { items, rows } = await getTimeline();
const fonts =
  'https://fonts.googleapis.com/css2?family=M+PLUS+1+Code:wght@400;500;700&display=swap';
const ym = (v?: string) => v ?? '現在';
// profile.md の links で label が一致するものはアイコンで表示する（simple-icons のパス）
const icons: Record<string, string> = {
  X: 'M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z',
  Wantedly:
    'M18.453 14.555c-.171-.111-.658-.764-2.006-3.982a9.192 9.192 0 0 0-.237-.526l-.274-.664-2.362-5.702H8.85l2.362 5.702 2.362 5.706 2.181 5.267a.196.196 0 0 0 .362 0l2.373-5.682a.1.1 0 0 0-.037-.119zm-8.85 0c-.171-.111-.658-.764-2.006-3.982a8.971 8.971 0 0 0-.236-.525l-.276-.665-2.36-5.702H0l2.362 5.702 2.362 5.706 2.181 5.267a.196.196 0 0 0 .362 0l2.374-5.682a.098.098 0 0 0-.038-.119ZM24 6.375a2.851 2.851 0 0 1-2.851 2.852 2.851 2.851 0 0 1-2.852-2.852 2.851 2.851 0 0 1 2.852-2.851A2.851 2.851 0 0 1 24 6.375Z',
};
---

<Base title={`${profile.name} | 職務経歴`} description={profile.headline} fonts={fonts} design="c">
  <div class="term">
    <header class="hero">
      <p class="prompt"><span>$</span> whoami</p>
      <div class="hero-id">
        <img src="/avatar.png" alt="" width="72" height="72" />
        <div>
          <h1>{profile.name}</h1>
          <div class="hero-sub">
            <p class="hero-meta">{profile.title} @ {profile.location}</p>
            <ul class="hero-links">
              {
                profile.links.map((l) => (
                  <li>
                    {icons[l.label] ? (
                      <a class="hero-icon" href={l.url} target="_blank" rel="me noopener noreferrer" aria-label={l.label}>
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                          <path d={icons[l.label]} />
                        </svg>
                      </a>
                    ) : (
                      <a href={l.url} target="_blank" rel="me noopener noreferrer">{l.label}</a>
                    )}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
      <p class="hero-headline">{profile.headline}</p>
      <div class="hero-intro"><profile.Content /></div>
    </header>

    <main>
      <p class="prompt"><span>$</span> git log --graph career</p>
      <ol class="log">
        {
          rows.map((row) => {
            if (row.kind === 'merge' || row.kind === 'fork') {
              return (
                <li class={`row ${row.kind}`} aria-hidden="true">
                  <span class="rail rail-0" />
                  <svg class="curve" width="36" height="28" viewBox="0 0 36 28">
                    <path d={row.kind === 'merge' ? 'M31 28 C31 12 7 16 7 0' : 'M31 0 C31 16 7 12 7 28'} />
                  </svg>
                </li>
              );
            }
            if (row.kind === 'origin') {
              return (
                <li class="row origin">
                  <span class="rail rail-0" />
                  <p class="commit-ref">
                    <span class="range">{row.item.start}</span>
                    <span class="dur">{row.item.company}として開業</span>
                  </p>
                </li>
              );
            }
            if (row.kind === 'role') {
              const { item, role } = row;
              return (
                <li class:list={['row', 'commit', 'on-branch', { tip: row.tip }]}>
                  <span class="rail rail-0" />
                  <span class="rail rail-1" />
                  <p class="commit-ref">
                    <span class="range">{role.start}..{ym(role.end)}</span>
                    <span class="dur">({role.duration})</span>
                    {item.contract && <span class="contract">{item.contract}</span>}
                    {row.tip && <span class="head">現在</span>}
                  </p>
                  <h2>{item.company}</h2>
                  <p class="commit-role">{role.role}</p>
                  {role.summary && <p class="commit-summary">{role.summary}</p>}
                  {role.highlights.length > 0 && (
                    <ul class="commit-files">
                      {role.highlights.map((h) => <li>{h}</li>)}
                    </ul>
                  )}
                  {role.tags.length > 0 && (
                    <ul class="commit-tags">
                      {role.tags.map((t) => <li>{t}</li>)}
                    </ul>
                  )}
                  {row.first && item.hasDetail && (
                    <button type="button" class="more" data-open={item.slug}>
                      詳しく見る
                    </button>
                  )}
                </li>
              );
            }
            const { item } = row;
            return (
              <li class:list={['row', 'commit', { current: item.current, education: item.type === 'education' }]}>
                <span class="rail rail-0" />
                <p class="commit-ref">
                  <span class="range">{item.start}..{ym(item.end)}</span>
                  <span class="dur">({item.duration})</span>
                  {item.current && <span class="head">HEAD</span>}
                </p>
                <h2>{item.company}</h2>
                <p class="commit-role">{item.role}</p>
                {item.summary && <p class="commit-summary">{item.summary}</p>}
                {item.highlights.length > 0 && (
                  <ul class="commit-files">
                    {item.highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}
                {item.tags.length > 0 && (
                  <ul class="commit-tags">
                    {item.tags.map((t) => <li>{t}</li>)}
                  </ul>
                )}
                {item.hasDetail && (
                  <button type="button" class="more" data-open={item.slug}>
                    詳しく見る
                  </button>
                )}
              </li>
            );
          })
        }
      </ol>

      <p class="prompt"><span>$</span> cat skills certifications</p>
      <div class="extras">
        <ul class="commit-tags">
          {profile.skills.map((s) => <li>{s}</li>)}
        </ul>
        <table>
          <tbody>
            {
              profile.certifications.map((c) => (
                <tr>
                  <td>{c.date}</td>
                  <td>{c.name}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </main>
  </div>

  {items.filter((i) => i.hasDetail).map((item) => <DetailDialog item={item} />)}
</Base>

<style is:global>
  body[data-design='c'] {
    --bg: #15202b;
    --text: #d6dee6;
    --muted: #8496a8;
    --line: #2c3c4c;
    --accent: #e8b65a;
    --branch: #5fb3d4;
    --branch2: #c79be0;
    --trunk: #3f7790;
    --dialog-bg: #1b2835;
    --dialog-radius: 8px;
    --dialog-border: 1px solid #3a4d60;
    --chip-bg: #263747;
    --chip-text: #a9d4e6;
    --backdrop: rgb(6 11 16 / 0.7);
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'M PLUS 1 Code', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 15px;
    line-height: 1.8;
  }

  @media (prefers-color-scheme: light) {
    body[data-design='c'] {
      --bg: #f3f5f7;
      --text: #1d2a36;
      --muted: #5b6b7a;
      --line: #cfd8e0;
      --accent: #9a5b00;
      --branch: #1b6f8f;
      --branch2: #8a3fa3;
      --trunk: #7fb2c6;
      --dialog-bg: #ffffff;
      --dialog-border: 1px solid #b9c5cf;
      --chip-bg: #e2e9ee;
      --chip-text: #17536b;
      --backdrop: rgb(20 30 40 / 0.5);
    }
  }

  [data-design='c'] .term {
    max-width: 820px;
    margin: 0 auto;
    padding: 48px 24px 140px;
  }

  [data-design='c'] .prompt {
    margin: 0 0 16px;
    color: var(--muted);
  }

  [data-design='c'] .prompt span {
    margin-right: 0.5em;
    color: var(--accent);
  }

  [data-design='c'] .hero {
    margin-bottom: 56px;
  }

  [data-design='c'] .hero h1 {
    margin: 0;
    font-size: clamp(1.75rem, 6vw, 2.5rem);
    font-weight: 700;
    line-height: 1.4;
  }

  [data-design='c'] .hero-id {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 20px;
  }

  [data-design='c'] .hero-id img {
    flex: none;
    width: 72px;
    height: 72px;
    border: 2px solid var(--line);
    border-radius: 50%;
    background: #fff;
    object-fit: cover;
  }

  [data-design='c'] .hero-id > div {
    flex: 1;
    min-width: 0;
  }

  [data-design='c'] .hero-sub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  [data-design='c'] .hero-links {
    display: flex;
    flex: none;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [data-design='c'] .hero-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--text);
  }

  [data-design='c'] .hero-icon:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  [data-design='c'] .hero-icon svg {
    fill: currentColor;
  }

  [data-design='c'] .hero-meta {
    margin: 2px 0 0;
    color: var(--branch);
  }

  [data-design='c'] .hero-headline {
    margin: 0;
    font-weight: 500;
  }

  [data-design='c'] .hero-intro p {
    margin: 0;
    color: var(--muted);
  }

  [data-design='c'] a {
    color: var(--branch);
    text-underline-offset: 4px;
  }

  [data-design='c'] .log {
    margin: 0 0 56px;
    padding: 0;
    list-style: none;
  }

  /* git log --graph 風のグラフ。レーン0（幹）は x=7px、レーン1（ブランチ）は x=31px */
  [data-design='c'] .row {
    position: relative;
  }

  [data-design='c'] .commit {
    padding: 0 0 36px 36px;
  }

  [data-design='c'] .commit.on-branch {
    padding-left: 60px;
  }

  [data-design='c'] .rail {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
  }

  [data-design='c'] .rail-0 {
    left: 6px;
    background: var(--trunk);
  }

  [data-design='c'] .rail-1 {
    left: 30px;
    background: var(--branch2);
  }

  /* 幹の両端とブランチの先端は、ノードの位置で線を止める */
  [data-design='c'] .row:first-child .rail-0,
  [data-design='c'] .commit.tip .rail-1 {
    top: 12px;
  }

  [data-design='c'] .row:last-child .rail-0 {
    bottom: auto;
    height: 12px;
  }

  [data-design='c'] .commit::after,
  [data-design='c'] .origin::after {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 10px;
    height: 10px;
    border: 2px solid var(--branch);
    border-radius: 50%;
    background: var(--bg);
  }

  [data-design='c'] .commit.on-branch::after {
    left: 24px;
    border-color: var(--branch2);
  }

  [data-design='c'] .commit.current::after {
    border-color: var(--accent);
    background: var(--accent);
  }

  [data-design='c'] .commit.education::after {
    border-radius: 0;
  }

  [data-design='c'] .origin {
    padding: 0 0 36px 36px;
  }

  [data-design='c'] .origin::after {
    left: 2px;
    top: 9px;
    width: 6px;
    height: 6px;
    background: var(--branch);
  }

  [data-design='c'] .merge,
  [data-design='c'] .fork {
    height: 28px;
  }

  [data-design='c'] .commit.on-branch:has(+ .fork) {
    padding-bottom: 12px;
  }

  [data-design='c'] .curve {
    display: block;
    fill: none;
    stroke: var(--branch2);
    stroke-width: 2;
  }

  [data-design='c'] .contract {
    margin-left: 0.6em;
    padding: 0 8px;
    border: 1px solid var(--branch2);
    border-radius: 3px;
    color: var(--branch2);
    font-size: 0.75rem;
  }

  [data-design='c'] .commit-ref {
    margin: 0;
    font-size: 0.875rem;
  }

  [data-design='c'] .range {
    color: var(--accent);
  }

  [data-design='c'] .dur {
    margin-left: 0.6em;
    color: var(--muted);
  }

  [data-design='c'] .head {
    margin-left: 0.6em;
    padding: 0 8px;
    border: 1px solid var(--accent);
    border-radius: 3px;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
  }

  [data-design='c'] .commit h2 {
    margin: 2px 0 0;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.5;
  }

  [data-design='c'] .commit-role {
    margin: 0 0 10px;
    color: var(--branch);
    font-size: 0.875rem;
  }

  [data-design='c'] .commit-summary {
    margin: 0 0 8px;
    max-width: 44em;
  }

  [data-design='c'] .commit-files {
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--muted);
  }

  [data-design='c'] .commit-files li::before {
    content: '+ ';
    color: var(--accent);
  }

  [data-design='c'] .commit-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }

  [data-design='c'] .commit-tags li {
    padding: 0 8px;
    border-radius: 4px;
    background: var(--chip-bg);
    color: var(--chip-text);
    font-size: 0.75rem;
    line-height: 1.9;
  }

  [data-design='c'] .more {
    padding: 4px 14px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background: transparent;
    color: var(--accent);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  [data-design='c'] .more::before {
    content: '> ';
  }

  [data-design='c'] .more:hover {
    background: var(--accent);
    color: var(--bg);
  }

  [data-design='c'] :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  [data-design='c'] .extras table {
    margin-top: 16px;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  [data-design='c'] .extras td {
    padding: 2px 0;
    vertical-align: top;
  }

  [data-design='c'] .extras td:first-child {
    padding-right: 1.5em;
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    body[data-design='c'] {
      font-size: 14px;
    }
    [data-design='c'] .term {
      padding: 32px 16px 120px;
    }
    [data-design='c'] .hero-id {
      gap: 14px;
    }
    [data-design='c'] .hero-id img {
      width: 60px;
      height: 60px;
    }
  }
</style>
